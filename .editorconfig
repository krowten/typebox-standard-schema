# https://editorconfig.org — mirrors what ESLint (@antfu, the sole formatter
# here: no prettier on purpose) enforces, for editors without the plugin.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
