{
  // A consumer's project, not ours: modern bundler resolution, no `paths`
  // pointing into dist/ (the import resolves through the package `exports`),
  // and no ambient @types the consumer would not have.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["consumer.ts"]
}
